# Production API variable placeholders; enter real values only in Railway.
# For local Docker Compose, keep the populated .env.production outside Git.
# Use the direct Neon AWS us-east-1 endpoint (no -pooler suffix), a dedicated
# production database/role, and a URL-encoded password. Migrations need a
# session-level advisory lock; the application already pools <=11 connections.
DATABASE_URL=postgresql://USER:REPLACE_ME@ep-REPLACE_ME.us-east-1.aws.neon.tech:5432/DATABASE?sslmode=verify-full
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME

# Receipt extraction and naming, all server-side.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://REPLACE_ME.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=REPLACE_ME
RECEIPT_NAME_BASE_URL=https://api.openai.com/v1
RECEIPT_NAME_MODEL=gpt-5.6-luna
RECEIPT_NAME_API_KEY=REPLACE_ME
RECEIPT_DAILY_LIMIT=50
